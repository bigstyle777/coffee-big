# 复制为 .env 后修改，docker compose 会自动读取
# 注意：.env 已被 .gitignore 忽略，不要提交真实密钥

# ---------- 运行环境 ----------
# 生产环境保持 prod；本地没有微信密钥、需要 H5 体验登录时改为 dev
SPRING_PROFILES_ACTIVE=prod

# ---------- MySQL ----------
# 必须填写，不要使用示例值
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=coffee_big
MYSQL_USER=coffee
MYSQL_PASSWORD=

# ---------- JWT ----------
# 必须填写，至少 32 位，建议使用 openssl rand -base64 48 生成
JWT_SECRET=

# ---------- 微信小程序 ----------
# 填入你自己的小程序 AppID，不要提交到公开仓库
WX_APP_ID=
# AppSecret 在微信公众平台「开发管理 -> 开发设置」中生成，切勿提交到仓库
WX_APP_SECRET=

# 初始店长微信 openid：该用户首次登录后自动成为 ADMIN，激活后可移除
ADMIN_OPENID=

# ---------- 支付 ----------
# 安全默认关闭模拟支付；本地演示可临时改为 true，公开部署必须保持 false
PAY_PROVIDER=mock
PAY_MOCK_ENABLED=false
# 微信支付回调地址，需要 HTTPS 且可公网访问
PAY_NOTIFY_URL=

# 微信支付商户号与证书：拿到商户号后再填写
WX_MCH_ID=
WX_API_V3_KEY=
WX_MERCHANT_SERIAL_NUMBER=
WX_PRIVATE_KEY_PATH=
WX_PAY_PUBLIC_KEY_ID=
WX_PAY_PUBLIC_KEY_PATH=

# ---------- 店长后台 ----------
# 首次启动且 sys_admin 表为空时创建，创建后修改环境变量不会覆盖已有密码
ADMIN_USERNAME=admin
# 至少 12 位强密码；留空则不会自动创建后台账号
ADMIN_PASSWORD=
ADMIN_TOKEN_EXPIRE_HOURS=12
# 店长后台浏览器访问端口
ADMIN_PORT=8082

# ---------- H5 访问端口 ----------
WEB_PORT=80
